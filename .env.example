# Copy to .env.local for local development. Values below are local-only defaults;
# never commit real secrets.

# Database: "pg" (node-postgres, local/CI) or "neon" (serverless driver, production).
DB_DRIVER=pg
DATABASE_URL=postgres://gesttask:gesttask@localhost:5433/gesttask

# Better Auth. Generate a real secret with: openssl rand -base64 32 (the placeholder is rejected in production).
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
# Public origin of the app (optional locally, required in production).
BETTER_AUTH_URL=http://localhost:3000
# Required in production. Rate limits need the real client address: on Vercel it is read from the platform
# headers; elsewhere set the number of trusted reverse proxies that append to X-Forwarded-For (0 = ignore it;
# production then refuses credential sign-in rather than share one bucket across all callers).
# TRUSTED_PROXY_HOPS=1

# Storage: "local" (default, no services), "s3" (RustFS locally, AWS S3 in production) or "blob".
STORAGE_DRIVER=local

# Only required when STORAGE_DRIVER=s3 (values target the docker-compose S3 service):
# S3_BUCKET=gesttask
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=gesttask
# AWS_SECRET_ACCESS_KEY=gesttask-secret
# S3_ENDPOINT=http://localhost:9000

# Only required when STORAGE_DRIVER=blob:
# BLOB_READ_WRITE_TOKEN=
